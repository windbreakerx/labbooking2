# Конфигурация бэкапа LabBooking.
# Скопировать в /etc/labbooking/backup.env и поправить пути.
# Права: chown root:root /etc/labbooking/backup.env && chmod 600 ...

# Каталог с docker-compose.yml
COMPOSE_DIR=/srv/labbooking2
# Куда складывать копии (желательно отдельный диск/раздел)
BACKUP_DIR=/srv/labbooking2/backups
# Каталог bind-mount данных (в нём лежат media/)
DATA_DIR=/srv/labbooking2/data

# Сколько копий хранить
HOURLY_KEEP=48
DAILY_KEEP=14
WEEKLY_KEEP=8
MONTHLY_KEEP=12
MEDIA_KEEP=8

# Офсайт-копия: rsync-цель, например backup@backup-host:/srv/labbooking2
# Оставьте пустым, чтобы отключить.
BACKUP_REMOTE=
