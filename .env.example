DEBUG=1
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_DB=labbooking2
POSTGRES_USER=labbooking
POSTGRES_PASSWORD=labbooking
# Docker: host "db". Local dev without Docker: host "localhost", port 5433
# (portable PostgreSQL, pg-start.bat).
DATABASE_URL=postgres://labbooking:labbooking@db:5432/labbooking2

REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
