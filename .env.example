# Сервер (docker compose): скопировать в .env, заполнить SECRET_KEY и пароль БД,
# в ALLOWED_HOSTS добавить IP/домен VM. HTTPS обязателен в проде.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# По умолчанию в prod включён редирект на HTTPS. Для локального HTTP-стенда
# без TLS задайте 0 явно и не открывайте порт 80 наружу.
SECURE_SSL_REDIRECT=1

POSTGRES_DB=labbooking2
POSTGRES_USER=labbooking
POSTGRES_PASSWORD=labbooking
# Внутри compose хост БД — "db". Локально без Docker — localhost:5433.
DATABASE_URL=postgres://labbooking:labbooking@db:5432/labbooking2

# Прод (Linux): данные БД и media на bind mount — удобно для бэкапа.
# Каталоги создать заранее и выставить владельцев:
#   mkdir -p /srv/labbooking2/{pgdata,media}
#   chown -R 70:70 /srv/labbooking2/pgdata      # postgres в alpine-образе = uid 70
#   chown -R 1000:1000 /srv/labbooking2/media   # appuser в контейнере = uid 1000
# POSTGRES_DATA_DIR=/srv/labbooking2/pgdata
# MEDIA_DATA_DIR=/srv/labbooking2/media

REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Лимит POST-запросов на вход в Django-админку (по умолчанию 10/m).
# ADMIN_LOGIN_RATE=10/m
# Лимит POST-запросов на обычный вход (по умолчанию 10/m).
# LOGIN_RATE=10/m

# Локальная разработка без Docker: портативный PostgreSQL 16, порт 5433.
# Порядок запуска и проверки — README.md, раздел «PostgreSQL на Windows».
# connect_timeout=5 нужен, чтобы при лежащей БД запросы падали за секунды,
# а не висели ~130 секунд на попытку.
# DJANGO_SETTINGS_MODULE=config.settings.dev
# DEBUG=1
# DATABASE_URL=postgres://postgres@localhost:5433/labbooking2?connect_timeout=5
# REDIS_URL=redis://127.0.0.1:6379/0
