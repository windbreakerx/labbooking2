# Сервер (docker compose): скопировать в .env, заполнить SECRET_KEY и пароль БД,
# в ALLOWED_HOSTS добавить IP/домен VM; при HTTPS — SECURE_SSL_REDIRECT=1.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# SECURE_SSL_REDIRECT=1

POSTGRES_DB=labbooking2
POSTGRES_USER=labbooking
POSTGRES_PASSWORD=labbooking
# Внутри compose хост БД — "db". Локально без Docker — localhost:5433.
DATABASE_URL=postgres://labbooking:labbooking@db:5432/labbooking2

REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Локальная разработка без Docker (портативный PostgreSQL, pg-start.bat):
# DJANGO_SETTINGS_MODULE=config.settings.dev
# DEBUG=1
# DATABASE_URL=postgres://postgres@localhost:5433/labbooking2
# REDIS_URL=redis://127.0.0.1:6379/0
